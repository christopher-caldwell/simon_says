diff --git a/manabrew-rs/crates/manabrew-engine/tests/bottom_departure.rs b/manabrew-rs/crates/manabrew-engine/tests/bottom_departure.rs
new file mode 100644
index 000000000..5de610358
--- /dev/null
+++ b/manabrew-rs/crates/manabrew-engine/tests/bottom_departure.rs
@@ -0,0 +1,100 @@
+use forge_foundation::{CardTypeLine, ColorSet, ManaCost, ZoneType};
+use manabrew_engine::{
+    card::CardInstance,
+    game::GameState,
+    ids::{CardId, PlayerId},
+    svar::resolve_count_svar,
+};
+#[test]
+fn putting_creature_on_bottom_counts_departure() {
+    let mut game = GameState::new(&["Alice", "Bob"], 20);
+    let player = PlayerId(0);
+    let card = game.create_card(CardInstance::new(
+        CardId(0),
+        "Creature".into(),
+        player,
+        CardTypeLine::parse("Creature"),
+        ManaCost::no_cost(),
+        ColorSet::COLORLESS,
+        Some(2),
+        Some(2),
+        vec![],
+        vec![],
+    ));
+    game.move_card(card, ZoneType::Battlefield, player);
+    game.put_on_bottom_of_library(card, player);
+    assert_eq!(game.card(card).zone, ZoneType::Library);
+    assert_eq!(
+        resolve_count_svar(
+            "Count$LeftBattlefieldThisTurn Creature.YouCtrl",
+            &game,
+            card,
+            player
+        ),
+        1
+    );
+}
+
+#[test]
+fn bottom_counts_battlefield_controller_and_tokens_but_not_other_zones_or_lands() {
+    let mut game = GameState::new(&["Alice", "Bob"], 20);
+    let (owner, controller) = (PlayerId(0), PlayerId(1));
+    let mut token = CardInstance::new(
+        CardId(0),
+        "Token".into(),
+        owner,
+        CardTypeLine::parse("Creature"),
+        ManaCost::no_cost(),
+        ColorSet::COLORLESS,
+        Some(2),
+        Some(2),
+        vec![],
+        vec![],
+    );
+    token.is_token = true;
+    let card = game.create_card(token);
+    game.move_card(card, ZoneType::Battlefield, controller);
+    game.put_on_bottom_of_library(card, owner);
+    assert_eq!(
+        resolve_count_svar(
+            "Count$LeftBattlefieldThisTurn Creature.YouCtrl",
+            &game,
+            card,
+            controller
+        ),
+        1
+    );
+    assert_eq!(
+        resolve_count_svar(
+            "Count$LeftBattlefieldThisTurn Creature.YouCtrl",
+            &game,
+            card,
+            owner
+        ),
+        0
+    );
+    let land = game.create_card(CardInstance::new(
+        CardId(0),
+        "Land".into(),
+        controller,
+        CardTypeLine::parse("Land"),
+        ManaCost::no_cost(),
+        ColorSet::COLORLESS,
+        None,
+        None,
+        vec![],
+        vec![],
+    ));
+    game.move_card(land, ZoneType::Battlefield, controller);
+    game.put_on_bottom_of_library(land, controller);
+    game.put_on_bottom_of_library(land, controller);
+    assert_eq!(
+        resolve_count_svar(
+            "Count$LeftBattlefieldThisTurn Creature.YouCtrl",
+            &game,
+            card,
+            controller
+        ),
+        1
+    );
+}
diff --git a/manabrew-rs/crates/manabrew-engine/tests/left_battlefield_this_turn.rs b/manabrew-rs/crates/manabrew-engine/tests/left_battlefield_this_turn.rs
new file mode 100644
index 000000000..9f1be593b
--- /dev/null
+++ b/manabrew-rs/crates/manabrew-engine/tests/left_battlefield_this_turn.rs
@@ -0,0 +1,72 @@
+use forge_foundation::{CardTypeLine, ColorSet, ManaCost, ZoneType};
+use manabrew_engine::{
+    card::CardInstance,
+    game::GameState,
+    ids::{CardId, PlayerId},
+    svar::resolve_count_svar,
+};
+
+fn card(owner: PlayerId, kind: &str, token: bool) -> CardInstance {
+    let mut card = CardInstance::new(
+        CardId(0),
+        "Test".into(),
+        owner,
+        CardTypeLine::parse(kind),
+        ManaCost::no_cost(),
+        ColorSet::COLORLESS,
+        None,
+        None,
+        vec![],
+        vec![],
+    );
+    card.is_token = token;
+    card
+}
+
+fn count(game: &GameState, source: CardId, player: PlayerId) -> i32 {
+    resolve_count_svar(
+        "Count$LeftBattlefieldThisTurn Creature.YouCtrl",
+        game,
+        source,
+        player,
+    )
+}
+
+#[test]
+fn counts_each_creature_departure_for_its_controller_and_resets() {
+    let mut game = GameState::new(&["Alice", "Bob"], 20);
+    let (a, b) = (PlayerId(0), PlayerId(1));
+    let source = game.create_card(card(a, "Sorcery", false));
+    let creature = game.create_card(card(b, "Creature", false));
+    game.move_card(creature, ZoneType::Battlefield, a);
+    assert_eq!(game.card(creature).controller, a);
+    game.move_card(creature, ZoneType::Exile, b);
+    assert_eq!(count(&game, source, a), 1);
+    assert_eq!(count(&game, source, b), 0);
+    game.move_card(creature, ZoneType::Battlefield, b);
+    game.move_card(creature, ZoneType::Hand, b);
+    assert_eq!(count(&game, source, a), 1);
+    assert_eq!(count(&game, source, b), 1);
+    game.new_turn_for_player(a);
+    assert_eq!(count(&game, source, a), 0);
+    assert_eq!(count(&game, source, b), 0);
+}
+
+#[test]
+fn counts_tokens_and_battlefield_characteristics_but_not_noncreatures() {
+    let mut game = GameState::new(&["Alice", "Bob"], 20);
+    let a = PlayerId(0);
+    let source = game.create_card(card(a, "Sorcery", false));
+    let token = game.create_card(card(a, "Creature", true));
+    game.move_card(token, ZoneType::Battlefield, a);
+    game.move_card(token, ZoneType::Graveyard, a);
+    let land = game.create_card(card(a, "Land", false));
+    game.move_card(land, ZoneType::Battlefield, a);
+    game.move_card(land, ZoneType::Graveyard, a);
+    let animated = game.create_card(card(a, "Land", false));
+    game.move_card(animated, ZoneType::Battlefield, a);
+    game.card_mut(animated).type_line = CardTypeLine::parse("Land Creature");
+    game.move_card(animated, ZoneType::Exile, a);
+    game.card_mut(animated).type_line = CardTypeLine::parse("Land");
+    assert_eq!(count(&game, source, a), 2);
+}
diff --git a/manabrew-rs/crates/manabrew-engine/tests/prevented_zone_move.rs b/manabrew-rs/crates/manabrew-engine/tests/prevented_zone_move.rs
